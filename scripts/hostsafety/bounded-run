#!/usr/bin/env bash
# bounded-run - run a command inside a transient systemd --user scope with hard
# resource limits and an optional wall-clock timeout.  Containment is by cgroup
# (systemctl --user kill/stop on the scope) - no process-group or pid signalling
# is ever done here, so a bad pgid can never reach "kill -1" (constitution 11.4.263).
#
# usage: bounded-run [-m MEM] [-t TASKS] [-c CPU%] [-s SWAP] [-T SECONDS] [-n NAME] [-q] [--tiny] [--no-disk-tmp] -- CMD [ARGS...]
#        bounded-run [--agent] [--tasks N] [--mem SIZE] [--timeout S] -- CMD [ARGS...]   (long forms of -t -m -T; --tasks=N also works)
#   Notes: short options (-m -t -T ...) are parsed AFTER the long ones and win; BOUNDED_RUN_* env vars override the --agent profile.
#          A nested bounded-run creates a SIBLING scope, not a child: the outer scope's caps do not cover it.
#          The timeout watchdog is a plain child of this wrapper; as an independent backstop the scope also carries
#          RuntimeMaxSec=timeout+10 and TimeoutStopSec=5, so it ends by itself even if the wrapper is killed.
#          systemd-run failing to start the scope exits 125.
#          Ctrl-C works: the command starts with SIGINT/SIGQUIT at their DEFAULT action (systemd-run runs as a background
#          job of this script, which would otherwise hand it both signals ignored), and INT/QUIT/TERM sent to bounded-run
#          are forwarded to the scope; a run ended by SIGINT exits 130. LIMIT (waived, review round 5 #7): a bounded-run
#          that is ITSELF started as a background job of a script inherits SIGINT/SIGQUIT ignored and cannot trap them,
#          so INT/QUIT sent to its pid alone do nothing (SIGTERM still works); Ctrl-C at a terminal reaches the command.
#          The command line is passed VERBATIM: systemd 254+ systemd-run would expand ${VAR} and $$ in it client-side
#          (unset => empty), so --expand-environment=no is passed; a systemd-run without that option makes a command that
#          contains '$' fail closed (exit 125: put it in a script file) rather than run expanded.
#          A run killed by SIGKILL cannot clean up: the next run removes its leftover state dir (and the disk TMPDIR it
#          recorded) once it is older than one day, carries this tool's owner marker, its owner is no live bounded-run and
#          its scope is not active; the TMPDIR is removed only when its REAL path is inside the real tmp root.
#   --agent  profile for agent / test probes: TasksMax=200, MemoryMax=1G, timeout 300 s (scripts/hostsafety/agent-run = bounded-run --agent).
#            The scope is never ManagedOOMPreference=avoid (oomd may pick a runaway probe before containers or the desktop);
#            on timeout ONLY this run's own scope is killed and stopped.
#   -m  MemoryMax   (systemd size, e.g. 6G)           default: 50% of MemTotal; < 1 GiB is refused unless --tiny
#       minimums: go test -race 4G; builds / archives 6G+; llama-server = model size + 3G (docs/host-safety.md)
#   -t  TasksMax    (count)                           default: clamp(nproc*128, 512, 8192)
#   -c  CPUQuota    (percent of ONE cpu, e.g. 400)    default: 75% of all CPUs
#   -s  MemorySwapMax                                 default: min(MemoryMax/2, SwapTotal/4) (not 0: shmem/tmpfs is only reclaimable via swap)
#   -T  wall-clock timeout in seconds (0 = none)      default: 0
#   -n  scope name suffix                             default: <pid>
#   -q  quiet (no banner)
#   --tiny         allow MemoryMax < 1 GiB (deliberate tiny containment tests only)
#   --no-disk-tmp  do NOT redirect TMPDIR (default: a per-run 0700 dir on DISK, removed on exit; /tmp is RAM-backed tmpfs and its
#                  pages are charged, unreclaimably, to the writing cgroup -> memcg OOM -> GNOME "Application Stopped")
#                  When the temp dir is a tmpfs (--no-disk-tmp, or BOUNDED_RUN_TMP_ROOT on tmpfs) a WARNING with its size and
#                  fullness is printed (even with -q): /tmp may be capped at a few GB (root-steps.sh tmp.mount drop-in).
# env: BOUNDED_RUN_MEM / _TASKS / _CPU / _SWAP / _TIMEOUT supply the defaults; BOUNDED_RUN_TMP_ROOT moves the TMPDIR root.
#      BOUNDED_RUN_STATE_ROOT moves the root of the run's private 0700 marker dir (default $XDG_RUNTIME_DIR/bounded-run, else
#      ${XDG_STATE_HOME:-~/.local/state}/bounded-run; never a shared /tmp).
# exit: the command's status; 124 on timeout; 125 on bounded-run's own error.
# Processes the command leaves behind (orphans) are killed when it exits - the scope is the unit.
# The memory high watermark is set to 75% of MemoryMax (reclaim/throttle before kill).
# Only a scope THIS run created is ever killed: if a scope named bounded-run-<NAME>.scope already exists the run
# exits 125 and leaves it alone; a start race lost to another run leaves no "started" marker, so neither the cleanup
# nor the timeout watchdog of the loser signals the winner's scope.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# installed copy lives next to lib.sh in ~/.local/share/hostsafety; repo copy next to it
for cand in "${here}/lib.sh" "${HOSTSAFETY_LIB:-/nonexistent}" "${XDG_DATA_HOME:-${HOME}/.local/share}/hostsafety/lib.sh"; do
  if [[ -r "${cand}" ]]; then
    # shellcheck source=lib.sh
    source "${cand}"; break
  fi
done
type hs_memtotal_bytes >/dev/null 2>&1 || { echo "bounded-run: hostsafety lib.sh not found" >&2; exit 125; }

mem_total="$(hs_memtotal_bytes)" || exit 125
cpus="$(hs_nproc)"
mem="${BOUNDED_RUN_MEM:-$((mem_total / 2))}"
tasks="${BOUNDED_RUN_TASKS:-$(hs_clamp $((cpus * 128)) 512 8192)}"
cpu="${BOUNDED_RUN_CPU:-$((cpus * 75))}"
swap="${BOUNDED_RUN_SWAP:-}"   # empty => computed below from the resolved MemoryMax
tiny=0 disk_tmp=1
timeout_s="${BOUNDED_RUN_TIMEOUT:-0}"
name="$$" quiet=0
# long flags (getopts has none): strip them from the arg list, stop at "--"
agent=0 l_mem="" l_tasks="" l_timeout=""
_args=()
while (( $# )); do
  _a="$1"
  case "${_a}" in
    --) _args+=("$@"); break ;;
    --tiny) tiny=1 ;;
    --no-disk-tmp) disk_tmp=0 ;;
    --agent) agent=1 ;;
    --mem|--tasks|--timeout)
      (( $# >= 2 )) || { echo "bounded-run: ${_a} needs a value" >&2; exit 125; }
      case "${_a}" in --mem) l_mem="$2" ;; --tasks) l_tasks="$2" ;; --timeout) l_timeout="$2" ;; esac
      shift ;;
    --mem=*) l_mem="${_a#*=}" ;;
    --tasks=*) l_tasks="${_a#*=}" ;;
    --timeout=*) l_timeout="${_a#*=}" ;;
    --*) echo "bounded-run: unknown option ${_a}" >&2; exit 125 ;;
    *) _args+=("${_a}") ;;
  esac
  shift
done
set -- "${_args[@]}"
# --agent: the profile for agent / test probes (what scripts/hostsafety/agent-run uses): 200 tasks, 1G, 300 s.  BOUNDED_RUN_* still win.
if (( agent )); then
  mem="${BOUNDED_RUN_MEM:-1G}"; tasks="${BOUNDED_RUN_TASKS:-200}"; timeout_s="${BOUNDED_RUN_TIMEOUT:-300}"
fi
[[ -n "${l_mem}" ]] && mem="${l_mem}"
[[ -n "${l_tasks}" ]] && tasks="${l_tasks}"
[[ -n "${l_timeout}" ]] && timeout_s="${l_timeout}"
while getopts ':m:t:c:s:T:n:qh' o; do
  case "${o}" in
    m) mem="${OPTARG}" ;; t) tasks="${OPTARG}" ;; c) cpu="${OPTARG}" ;;
    s) swap="${OPTARG}" ;; T) timeout_s="${OPTARG}" ;; n) name="${OPTARG}" ;; q) quiet=1 ;;
    h) sed -n '2,49p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "bounded-run: bad option -${OPTARG:-?}" >&2; exit 125 ;;
  esac
done
shift $((OPTIND - 1))
[[ "${1:-}" == "--" ]] && shift
(( $# > 0 )) || { echo "bounded-run: no command given (usage: bounded-run [opts] -- CMD...)" >&2; exit 125; }
[[ "${tasks}" =~ ^[0-9]+$ && "${cpu}" =~ ^[0-9]+$ && "${timeout_s}" =~ ^[0-9]+$ ]] || { echo "bounded-run: tasks/cpu/timeout must be integers" >&2; exit 125; }
[[ "${name}" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "bounded-run: bad scope name '${name}'" >&2; exit 125; }

# resolve MemoryMax into bytes for the 80% MemoryHigh watermark
mem_bytes="$(numfmt --from=iec "${mem}" 2>/dev/null)" || { echo "bounded-run: bad memory size '${mem}'" >&2; exit 125; }
[[ "${mem_bytes}" =~ ^[0-9]+$ ]] || { echo "bounded-run: memory size '${mem}' is not a whole number of bytes" >&2; exit 125; }
min_bytes=$((1024 * 1024 * 1024))
if (( mem_bytes < min_bytes && ! tiny )); then
  echo "bounded-run: MemoryMax ${mem} is below 1 GiB - refused. Small caps OOM-kill ordinary tools (git, zip, go) and GNOME then shows 'Application Stopped'." >&2
  echo "bounded-run: use at least go test -race 4G, builds/archives 6G, llama-server model+3G; pass --tiny only for a deliberate tiny containment test (docs/host-safety.md)." >&2
  exit 125
fi
high=$((mem_bytes * 75 / 100))   # a real gap below Max: the kernel reclaims/throttles here long before any kill
if [[ -z "${swap}" ]]; then      # shmem/tmpfs pages are only reclaimable via swap; a little swap beats an OOM kill, never more than 1/4 of the device
  swap="$(hs_min $((mem_bytes / 2)) $(($(hs_swaptotal_bytes) / 4)))"
fi
if [[ ! "${swap}" =~ ^[0-9]+$ ]]; then   # -s takes a size like 512M (or bytes); anything else is refused here, not handed to systemd
  _sw="$(numfmt --from=iec "${swap}" 2>/dev/null)" && [[ "${_sw}" =~ ^[0-9]+$ ]] || { echo "bounded-run: bad -s swap size '${swap}'" >&2; exit 125; }
  swap="${_sw}"
fi
unit="bounded-run-${name}.scope"
# Only a scope THIS run created may be killed: a name collision must never reach another run's scope.
_ls="$(systemctl --user show "${unit}" -p LoadState --value 2>/dev/null)"
if [[ -n "${_ls}" && "${_ls}" != not-found ]]; then
  echo "bounded-run: scope ${unit} already exists (LoadState=${_ls}) - refusing; pick another -n NAME. The running scope is untouched." >&2
  exit 125
fi

# systemd 254+ expands ${VAR} and $$ in the command line itself (unset => empty: `D=$HOME/x; rm -rf "${D}"/*` became
# `rm -rf /*`). Pass the command verbatim; without the option, refuse a command that contains '$' instead of running it.
expand_args=()
if [[ "$(systemd-run --help 2>/dev/null)" == *--expand-environment* ]]; then
  expand_args=(--expand-environment=no)  # MUTANT-ANCHOR:noexpand
else
  for _a in "$@"; do
    if [[ "${_a}" == *'$'* ]]; then
      echo "bounded-run: this systemd-run has no --expand-environment=no, so it could expand \${VAR} and \$\$ in the command line (unset => empty); refusing a command that contains '\$' - put it in a script file" >&2
      exit 125  # MUTANT-ANCHOR:expand-fail-closed
    fi
  done
fi

run_tmp=""
tmp_root="${BOUNDED_RUN_TMP_ROOT:-${XDG_CACHE_HOME:-${HOME}/.cache}/bounded-run/tmp}"
if (( disk_tmp )); then
  mkdir -p "${tmp_root}" 2>/dev/null && chmod 0700 "${tmp_root}" && run_tmp="$(mktemp -d "${tmp_root}/${name}.XXXXXX" 2>/dev/null)" \
    || { echo "bounded-run: cannot create a disk-backed TMPDIR under ${tmp_root} (use --no-disk-tmp to skip)" >&2; exit 125; }
  chmod 0700 "${run_tmp}"
  export TMPDIR="${run_tmp}" TEMP="${run_tmp}" TMP="${run_tmp}" GOTMPDIR="${run_tmp}"   # inherited by the scope's command
fi
# /tmp (and /dev/shm, $XDG_RUNTIME_DIR) are RAM.  Whenever the command's temp dir ends up on a tmpfs - --no-disk-tmp, or a
# BOUNDED_RUN_TMP_ROOT on tmpfs - say so with its size and fullness, even with -q: files there pin memory that killing a
# process cannot free, and /tmp may be only a few GB (docs/host-safety.md, 2026-10-14 hang).  A warning, never a refusal.
_eff_tmp="${run_tmp:-${TMPDIR:-/tmp}}"
if [[ "$(stat -f -c %T "${_eff_tmp}" 2>/dev/null)" == tmpfs ]]; then
  _df="$(df -B1 --output=size,used "${_eff_tmp}" 2>/dev/null | tail -1)"
  read -r _tsz _tused <<<"${_df}"
  echo "bounded-run: WARNING: the command's temp dir ${_eff_tmp} is tmpfs (RAM): size $(numfmt --to=iec "${_tsz:-0}" 2>/dev/null || echo ?), used $(numfmt --to=iec "${_tused:-0}" 2>/dev/null || echo ?). Files there pin memory (killing a process frees none of it); put big artifacts on disk (${XDG_CACHE_HOME:-${HOME}/.cache}/...)." >&2
fi
(( quiet )) || echo "bounded-run: ${unit} MemoryMax=${mem} MemoryHigh=${high} TasksMax=${tasks} CPUQuota=${cpu}% SwapMax=${swap}${run_tmp:+ TMPDIR=${run_tmp}} timeout=${timeout_s}s" >&2
# The run's own markers live in a PRIVATE 0700 dir (mktemp -d) under a per-user state root - never in a shared directory:
# with XDG_RUNTIME_DIR unset the old fallback was /tmp, where another user could pre-create the predictable "<flag>.claim"
# and steal the verdict (review B3, 2026-10-14).  BOUNDED_RUN_STATE_ROOT moves the root (tests).
state_root="${BOUNDED_RUN_STATE_ROOT:-${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}}/bounded-run}"
state=""
mkdir -p "${state_root}" 2>/dev/null && chmod 0700 "${state_root}" 2>/dev/null \
  && state="$(mktemp -d "${state_root}/run.XXXXXX" 2>/dev/null)" && [[ -n "${state}" ]] \
  || { echo "bounded-run: cannot create a private state dir under ${state_root}" >&2; exit 125; }
echo "$$" >"${state}/owner"                                  # who owns this dir (the stale sweep below never takes a live one)
echo "${unit}" >"${state}/unit"                              # its scope: never swept while that scope is still active
[[ -n "${run_tmp}" ]] && printf '%s\n' "${run_tmp}" >"${state}/tmp"   # the disk TMPDIR to remove if this run is SIGKILLed
# A run killed by SIGKILL never runs its EXIT trap: its state dir (and the TMPDIR it recorded) would stay forever. Remove
# leftovers older than one day that carry this tool's owner marker, whose owner is not a live bounded-run and whose scope
# is not active; the recorded TMPDIR only when its REAL path lies inside the REAL tmp root (no symlinked component).
_rroot="$(realpath -e -- "${tmp_root}" 2>/dev/null)"
for _d in "${state_root}"/run.*; do
  [[ -d "${_d}" && ! -L "${_d}" && "${_d}" != "${state}" ]] || continue
  [[ -f "${_d}/owner" && ! -L "${_d}/owner" ]] || continue  # MUTANT-ANCHOR:stale-marker
  [[ -n "$(find "${_d}" -maxdepth 0 -mmin +1440 2>/dev/null)" ]] || continue
  _o="$(cat "${_d}/owner" 2>/dev/null)"; _c=""
  [[ "${_o}" =~ ^[0-9]+$ ]] && _c="$(tr '\0' ' ' 2>/dev/null <"/proc/${_o}/cmdline")"
  [[ "${_c}" == *bounded-run* ]] && continue
  _u="$(cat "${_d}/unit" 2>/dev/null)"
  if [[ "${_u}" =~ ^bounded-run-[A-Za-z0-9_.-]+\.scope$ ]]; then
    case "$(systemctl --user is-active "${_u}" 2>/dev/null)" in active|activating|deactivating|reloading|refreshing) continue ;; esac  # MUTANT-ANCHOR:stale-unit
  fi
  _t="$(cat "${_d}/tmp" 2>/dev/null)"; _rt=""
  [[ -n "${_t}" ]] && _rt="$(realpath -e -- "${_t}" 2>/dev/null)"
  [[ -n "${_rt}" && -n "${_rroot}" && "${_rt}" == "${_rroot}/"* && -d "${_rt}" ]] && rm -rf -- "${_rt}"  # MUTANT-ANCHOR:stale-realpath
  rm -rf -- "${_d}"
done
started="${state}/started"   # written by the wrapper INSIDE the scope we created: proof that the scope is ours
# The run's verdict (completed vs timed out) is decided ONCE, atomically: whoever mkdir()s ${claim} first owns it.  The
# watchdog may write "timeout" / signal the scope only after winning the claim; the wrapper claims "completed" as soon as
# the command has exited, BEFORE it stops the watchdog.  So stopping the watchdog (pkill/kill, in any order, with any
# scheduling delay) can never turn a finished command into a 124 (measured: 2/200 spurious 124s before, 2026-10-14).
claim="${state}/claim"
# shellcheck disable=SC2329  # invoked via trap
cleanup() { [[ -n "${state}" && -d "${state}" ]] && rm -rf -- "${state}"; [[ -n "${run_tmp}" && -d "${run_tmp}" ]] && rm -rf -- "${run_tmp}"; return 0; }
trap cleanup EXIT

# second line of defence, independent of this wrapper and its watchdog (both plain processes): the SCOPE itself ends at timeout+10 s
rms_args=()
(( timeout_s > 0 )) && rms_args=(-p RuntimeMaxSec="$((timeout_s + 10))" -p TimeoutStopSec=5)
systemd-run --user --scope --quiet --collect "${expand_args[@]}" --unit="${unit}" \
  -p MemoryMax="${mem_bytes}" -p MemoryHigh="${high}" -p MemorySwapMax="${swap}" \
  -p TasksMax="${tasks}" -p CPUQuota="${cpu}%" -p OOMPolicy=kill "${rms_args[@]}" \
  -- env --default-signal=INT,QUIT bash -c 'echo "$$" >"$1"; shift; exec "$@"' bounded-run-wrap "${started}" "$@" &
runner=$!

watchdog=""
if (( timeout_s > 0 )); then
  (
    # watchdog fds are detached from any $(...) capture (shell-instrument footgun I7)
    # Sleep until the deadline.  An early end of the sleep means "the wrapper is stopping us" ONLY when the wrapper has
    # already claimed "completed"; anything else that killed the sleep (an external pkill, the OOM killer) must not drop
    # the deadline, so the remaining time is slept again (review B1, 2026-10-14).
    deadline=$((SECONDS + timeout_s))
    while (( SECONDS < deadline )); do
      sleep "$((deadline - SECONDS))" && break
      [[ -d "${claim}" ]] && exit 0     # the wrapper claimed "completed" and stopped our sleep
    done
    [[ -s "${started}" ]] || exit 0      # our scope never started (e.g. lost a name race): nothing of ours to kill
    mkdir "${claim}" 2>/dev/null || exit 0   # the wrapper already claimed "completed": the command finished first
    systemctl --user kill --kill-whom=all --signal=SIGTERM "${unit}" 2>/dev/null
    sleep 3
    systemctl --user kill --kill-whom=all --signal=SIGKILL "${unit}" 2>/dev/null
    systemctl --user stop "${unit}" 2>/dev/null
  ) >/dev/null 2>&1 &
  watchdog=$!
fi

# forward INT/QUIT/TERM to the scope (by cgroup), never by pgid
# shellcheck disable=SC2329  # invoked via trap
forward() { [[ -s "${started}" ]] && systemctl --user kill --kill-whom=all --signal="$1" "${unit}" 2>/dev/null; return 0; }
trap 'forward SIGTERM' TERM
trap 'forward SIGINT' INT
trap 'forward SIGQUIT' QUIT

wait "${runner}"; rc=$?
while [[ ${rc} -ge 128 && ! -d "${claim}" ]] && kill -0 "${runner}" 2>/dev/null; do wait "${runner}"; rc=$?; done
# decide the verdict FIRST (atomic claim), only then stop the watchdog: no stop ordering can flip it afterwards
we_claimed=0
mkdir "${claim}" 2>/dev/null && we_claimed=1
if [[ -n "${watchdog}" ]]; then
  # stop the sleeping watchdog subshell and its sleep child without signalling a group.  The watchdog is an un-reaped
  # child until the wait below, so its pid cannot have been reused; pkill -P first so its sleep is not orphaned.
  pkill -P "${watchdog}" 2>/dev/null
  kill "${watchdog}" 2>/dev/null
  wait "${watchdog}" 2>/dev/null
fi
timed_out=0
(( ! we_claimed )) && [[ -d "${claim}" ]] && timed_out=1   # the watchdog won the claim: a real deadline expiry
# the scope never started (systemd-run failed: no user manager, bad property, ...): the command did not run - 125, not systemd-run's status
if [[ ! -s "${started}" && ${rc} -ne 0 ]] && (( ! timed_out )); then
  echo "bounded-run: systemd-run could not start ${unit} (status ${rc}); the command did not run" >&2
  exit 125
fi
# the scope is the unit of containment: anything the command left behind dies with the run (only if it is OURS)
if [[ -s "${started}" ]]; then systemctl --user kill --kill-whom=all --signal=SIGKILL "${unit}" >/dev/null 2>&1; fi
if (( timed_out )); then
  (( quiet )) || echo "bounded-run: TIMEOUT after ${timeout_s}s - scope ${unit} terminated" >&2
  exit 124
fi
exit "${rc}"
