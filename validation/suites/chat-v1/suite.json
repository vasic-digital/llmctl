{
 "suite": "chat-v1",
 "kind": "chat",
 "schema": 1,
 "notes": "Known-answer prompts for general chat profiles. Every expected answer is a fact or a computation with exactly one correct value; the judge is deterministic (docs/validation.md \"Suites and the judge\": a number answer must be only the number; one-word answers are short and name no alternative; the echo must be exact; the JSON must be exactly one document equal to the expected one; a negated, denied or retracted mention is not a claim). max_tokens (2048) leaves room for reasoning-channel models; only message.content is judged, and a completion cut off by the budget (finish_reason=length) or with empty content but reasoning content is UNDETERMINED, never FAIL and never PASS.",
 "request": {"temperature": 0, "seed": 42, "top_k": 1, "top_p": 1.0, "max_tokens": 2048, "cache_prompt": false},
 "determinism_repeat": ["arith"],
 "cases": [
  {"id": "arith", "prompt": "What is 17 + 25? Answer with only the number.", "checks": {"number_equals": 42}},
  {"id": "compare", "prompt": "Which number is larger, 9 or 4? Answer with only the number.", "checks": {"number_equals": 9}},
  {"id": "capital", "prompt": "What is the capital city of France? Answer with one word.", "checks": {"contains_all": ["PARIS"], "forbidden": ["LONDON", "BERLIN", "MADRID", "LYON", "ROME"], "max_words": 6}},
  {"id": "echo", "prompt": "Repeat exactly this code and nothing else: ZX-4417", "checks": {"exact_text": "ZX-4417"}},
  {"id": "json", "prompt": "Return a JSON object with exactly one key \"color\" whose value is the string \"blue\". Output only the JSON.", "checks": {"json_equals": {"color": "blue"}}}
 ],
 "judge_controls": [
  {"probe": "arith", "answer": "42", "expect": "pass"},
  {"probe": "arith", "answer": "The answer is 41.", "expect": "fail"},
  {"probe": "arith", "answer": "", "expect": "fail"},
  {"probe": "arith", "answer": "17 + 25 = 42", "expect": "pass"},
  {"probe": "arith", "answer": "17 + 25 = 41", "expect": "fail"},
  {"probe": "arith", "answer": "17 + 25", "expect": "fail"},
  {"probe": "arith", "answer": "42,000", "expect": "fail"},
  {"probe": "arith", "answer": ".42", "expect": "fail"},
  {"probe": "compare", "answer": "9", "expect": "pass"},
  {"probe": "compare", "answer": "4", "expect": "fail"},
  {"probe": "capital", "answer": "Paris.", "expect": "pass"},
  {"probe": "capital", "answer": "London", "expect": "fail"},
  {"probe": "echo", "answer": "ZX-4417", "expect": "pass"},
  {"probe": "echo", "answer": "ZX-4471", "expect": "fail"},
  {"probe": "json", "answer": "```json\n{\"color\": \"blue\"}\n```", "expect": "pass"},
  {"probe": "json", "answer": "{\"color\": \"red\"}", "expect": "fail"},
  {"probe": "json", "answer": "color: blue", "expect": "fail"},
