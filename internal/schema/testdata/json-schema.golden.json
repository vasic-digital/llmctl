{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "min_confidence": {
      "description": "tool-level, not sent to the gateway: when any answer's confidence is lower (a flagged answer is capped at 1 - its largest upper bound) the answer is withheld and the call is reported as an error (fail closed)",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "model": {
      "description": "decision profile id; omit for the gateway default",
      "type": "string"
    },
    "questions": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "criteria": {
            "anyOf": [
              {
                "additionalProperties": {
                  "description": "free text; may be empty",
                  "type": "string"
                },
                "maxProperties": 255,
                "minProperties": 2,
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "false": {
                    "description": "free text; may be empty",
                    "type": "string"
                  },
                  "true": {
                    "description": "free text; may be empty",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "items": {
                  "description": "free text; may be empty",
                  "type": "string"
                },
                "maxItems": 10,
                "minItems": 2,
                "type": "array"
              }
            ],
            "description": "noul: optional {\"true\":text,\"false\":text}; choice: {\"option\":description,...} with 2..255 options (a gateway may allow fewer, default 20); score: array of 2..10 level descriptions"
          },
          "instructions": {
            "description": "the question to answer about the state",
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "description": "noul: yes/no; choice: one of the named options; score: ordinal level",
            "enum": [
              "noul",
              "choice",
              "score"
            ]
          }
        },
        "required": [
          "type",
          "instructions"
        ],
        "type": "object"
      },
      "description": "question name -> typed question; the names key the answers",
      "maxProperties": 32,
      "minProperties": 1,
      "type": "object"
    },
    "state": {
      "description": "what the question is about: text, or any JSON object or array (delimited and neutralised as data - best effort, not a guarantee)",
      "type": [
        "string",
        "object",
        "array"
      ]
    }
  },
  "required": [
    "state",
    "questions"
  ],
  "title": "llmctl decision call",
  "type": "object"
}
