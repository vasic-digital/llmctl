# Copy to .env, fill in real values, then: chmod 600 .env
# .env is gitignored — never commit real credentials (Constitution §11.4.10).

# Hugging Face API token, used for model downloads requiring authentication
# (gated/private repos). Optional for public catalog profiles.
HF_TOKEN=

# llmctld cluster daemon — JWT signing key for client-facing bearer tokens.
# Only required when cluster mode (US7-9) is enabled. Generate with e.g.
# `openssl rand -base64 32`.
LLMCTLD_JWT_SIGNING_KEY=

# llmctld cluster daemon — optional OIDC issuer URL for SSO integration.
# Leave blank to use built-in local auth only.
LLMCTLD_OIDC_ISSUER=

# llmctld cluster daemon — optional master secret for per-tenant
# encryption at rest of replicated KV-cache/WAL state (Clarification 20,
# FR-051). Leave blank to store every tenant's replication state in
# plaintext (per-tenant directory isolation still applies via
# Clarification 18 — see LLMCTLD_TENANT_ENCRYPTION_KEY's use in
# cmd/llmctld/main.go). When set, generate with e.g. `openssl rand -base64 32`.
LLMCTLD_TENANT_ENCRYPTION_KEY=
