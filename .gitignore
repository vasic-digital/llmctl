# Credentials — never versioned (Constitution §11.4.10, §11.4.30)
.env
.env.*
!.env.example

# Go build artifacts / caches (llmctld)
llmctld/llmctld
llmctld/bin/
llmctld/*.test

# Downloaded model weights (verified via sha256 at download time, not versioned)
/models/*.gguf
/models/downloads/

# Engine build outputs
vendor/*/build/

# Release archives written next to the repo by `make archive`
/*.tar.gz
/*.zip

# Secrets / key material — never versioned, never released (spec 009 FR-087, D-30)
cert/
cert/**
decide/log.key
*.key
*.pem

# Go decision binary (llmctl build decide)
/build/

# Python bytecode (defect D-25)
__pycache__/
*.pyc

# Resolved (NOT vendored) dependencies - single source of truth lives in the constitution hub / on the host.
# These are symlinks created by scripts/link_deps.sh from what lib/resolve_deps.sh resolves.
/constitution
/submodules/containers
/submodules/superspec
