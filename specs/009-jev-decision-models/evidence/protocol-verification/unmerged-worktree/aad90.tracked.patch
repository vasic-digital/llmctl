+# --- a profile the gateway cannot serve is NEVER recommended -------------------
+# decide-tiny (protocol jev-verdict: the vendor's readout is a " ->" verdict slot per option, no
+# gateway driver) and decide-nli (2-label NLI head entailment/not_entailment; the nli-onnx driver needs
+# a contradiction column) fit every host below, but `plan`, `auto decide` and co-residency must not
+# offer them as usable (evidence/protocol-verification/verification.json).
+for fx in baseline workstation apple; do
+  pj_s="$(plan_for "${fx}")"
+  for up in decide-tiny decide-nli; do
+    assert_eq "False False" "$(printf '%s' "${pj_s}" | json_stdin "str(d[\"profiles\"][\"${up}\"][\"servable\"]) + ' ' + str(d[\"profiles\"][\"${up}\"][\"recommended\"])")" \
+      "${fx}: ${up} is not servable and therefore not recommended"
+    assert_eq "False" "$(printf '%s' "${pj_s}" | json_stdin "str(\"${up}\" in d[\"recommended\"] or any(\"${up}\" in g[\"profiles\"] for g in d[\"coresidency_groups\"]))")" \
+      "${fx}: ${up} is in neither the recommended set nor a co-residency group"
+    assert_eq "False" "$(printf '%s' "${pj_s}" | json_stdin "str(d[\"decision_instances\"][\"${up}\"][\"servable\"])")" \
+      "${fx}: ${up}'s capacity entry says it is not servable (memory arithmetic kept, never presented as usable capacity)"
+  done
+  # golden-false: a servable profile that fits stays recommended (the gate must not over-refuse)
+  assert_eq "True True" "$(printf '%s' "${pj_s}" | json_stdin 'str(d["profiles"]["decide-kev-08b"]["servable"]) + " " + str(d["profiles"]["decide-kev-08b"]["recommended"])')" \
+    "${fx}: decide-kev-08b (servable, fits) stays recommended"
+done
+assert_contains "$(printf '%s' "$(plan_for baseline)" | json_stdin 'd["profiles"]["decide-tiny"]["not_servable"]')" "jev-verdict" "the plan names why decide-tiny is not servable"
+assert_contains "$(printf '%s' "$(plan_for baseline)" | json_stdin 'd["profiles"]["decide-nli"]["not_servable"]')" "contradiction" "the plan names why decide-nli is not servable"
+human_s="$(plan_for baseline | catalog_plan_human)"
+assert_contains "$(printf '%s\n' "${human_s}" | grep '^decide-tiny ')" "UNSERVABLE" "human plan marks decide-tiny UNSERVABLE"
+assert_contains "$(printf '%s\n' "${human_s}" | grep '^decide-nli ')" "UNSERVABLE" "human plan marks decide-nli UNSERVABLE"
